{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JharlyOk Profile Configuration",
  "description": "Schema definition for the custom SVG profile engine configuration.",
  "type": "object",
  "required": ["identity", "themes", "banner", "projects", "stack", "socials"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL to this JSON Schema definition."
    },

    "modules": {
      "type": "object",
      "description": "Feature toggles: enable or disable individual SVG profile components.",
      "properties": {
        "header": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          ],
          "description": "Typewriter welcome greeting + 4 active systems highlight cards."
        },
        "banner": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          ],
          "description": "Neovim/VS Code-style TypeScript code editor card with syntax highlighting."
        },
        "projects": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          ],
          "description": "Terminal window showing active projects and repositories."
        },
        "stack": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          ],
          "description": "Terminal grid matrix showing categorized tools, runtimes, and frameworks."
        },
        "stats": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          ],
          "description": "Terminal banner (880px) displaying unified GitHub stats, stars, repos, network, and telemetry."
        },
        "socials": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          ],
          "description": "Terminal banner (880px) displaying communication channels, handles, and SLAs."
        },
        "badges": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          ],
          "description": "Standalone clickable split-pill vector badges for social links."
        },
        "telemetry": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          ],
          "description": "Dynamic GitHub telemetry and visitor metric split-pill badges."
        }
      }
    },

    "identity": {
      "type": "object",
      "description": "Profile owner identity, titles, highlights, and welcome animation messages.",
      "required": ["handle", "role", "tagline"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to render and compile the header component."
        },
        "handle": {
          "type": "string",
          "description": "GitHub username or main alias (e.g. JharlyOk)."
        },
        "role": {
          "type": "string",
          "description": "Primary role or title displayed on the profile."
        },
        "tagline": {
          "type": "string",
          "description": "Short bio or engineering manifesto."
        },
        "highlights": {
          "type": "array",
          "description": "Cards displayed on the header (up to 4 cards recommended).",
          "items": {
            "type": "object",
            "required": ["label", "detail"],
            "properties": {
              "icon": {
                "type": "string",
                "enum": ["bot", "audio", "ai", "infra", "web"],
                "description": "Icon type for color accent and status mapping."
              },
              "label": {
                "type": "string",
                "description": "Main title of the highlight card."
              },
              "detail": {
                "type": "string",
                "description": "Subtitle describing the highlight."
              }
            }
          }
        },
        "welcome_messages": {
          "type": "array",
          "description": "List of strings cycled by the typewriter SMIL animation in the header.",
          "items": { "type": "string" }
        },
        "telemetry": {
          "type": "object",
          "description": "Live telemetry pills integrated directly within the header SVG.",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "metrics": {
              "type": "object",
              "description": "Granular toggles for each telemetry metric in the header.",
              "properties": {
                "followers": {
                  "oneOf": [
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "label": { "type": "string" },
                        "icon": { "type": "string" },
                        "accent": { "type": "string" },
                        "prefix": { "type": "string" },
                        "suffix": { "type": "string" },
                        "sub": { "type": "string" }
                      }
                    }
                  ],
                  "default": true
                },
                "repos": {
                  "oneOf": [
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "label": { "type": "string" },
                        "icon": { "type": "string" },
                        "accent": { "type": "string" },
                        "prefix": { "type": "string" },
                        "suffix": { "type": "string" },
                        "sub": { "type": "string" }
                      }
                    }
                  ],
                  "default": true
                },
                "stars": {
                  "oneOf": [
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "label": { "type": "string" },
                        "icon": { "type": "string" },
                        "accent": { "type": "string" },
                        "prefix": { "type": "string" },
                        "suffix": { "type": "string" },
                        "sub": { "type": "string" }
                      }
                    }
                  ],
                  "default": false
                },
                "views": {
                  "oneOf": [
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "label": { "type": "string" },
                        "icon": { "type": "string" },
                        "accent": { "type": "string" },
                        "prefix": { "type": "string" },
                        "suffix": { "type": "string" },
                        "sub": { "type": "string" }
                      }
                    }
                  ],
                  "default": true
                }
              }
            }
          }
        }
      }
    },

    "themes": {
      "type": "object",
      "description": "Active theme identifiers mapped to themes/<name>.json.",
      "required": ["dark", "light"],
      "properties": {
        "dark": { "type": "string", "default": "github-dark" },
        "light": { "type": "string", "default": "github-light" }
      }
    },

    "banner": {
      "type": "object",
      "description": "Configuration for the Neovim code manifest card.",
      "required": ["filename", "code_lines"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to compile and render the Neovim code manifest banner."
        },
        "filename": { "type": "string", "description": "Tab name in editor header." },
        "filepath": { "type": "string", "description": "Relative path in project." },
        "language": { "type": "string", "description": "Language label for the badge." },
        "git_branch": { "type": "string", "description": "Branch name for statusline." },
        "code_lines": {
          "type": "array",
          "description": "Lines of code with tokenized syntax highlighting.",
          "items": {
            "type": "object",
            "properties": {
              "tokens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "text"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["keyword", "string", "comment", "type", "property", "function", "punctuation"]
                    },
                    "text": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "projects": {
      "description": "Active projects featured in the projects terminal card.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type", "description"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "description": { "type": "string" },
                  "tags": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "description"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "description": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      ]
    },

    "stack": {
      "type": "object",
      "description": "Categorized technology stack displayed in the matrix grid.",
      "properties": {
        "enabled": { "type": "boolean", "default": true, "description": "Whether to compile the stack matrix." }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "items"],
        "properties": {
          "label": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "stats": {
      "type": "object",
      "description": "Granular metric cards and statusline configuration for GitHub stats banner.",
      "properties": {
        "enabled": { "type": "boolean", "default": true, "description": "Whether to compile the 880px stats terminal banner card." },
        "badges": { "type": "boolean", "default": false, "description": "Whether to compile loose metric badges (followers, repos, stars, views) at the bottom." },
        "command": { "type": "string" },
        "badge_text": { "type": "string" },
        "badge_accent": {
          "type": "string",
          "description": "Accent token (primary, secondary, success, warning, danger) or hex color for live badge."
        },
        "metrics": {
          "description": "Granular metric cards configuration (as map or list, equal to socials).",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "repos": {
                  "oneOf": [
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "label": { "type": "string" },
                        "badge_label": { "type": "string" },
                        "icon": { "type": "string" },
                        "accent": { "type": "string" },
                        "prefix": { "type": "string" },
                        "suffix": { "type": "string" },
                        "sub": { "type": "string" },
                        "value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                        "display_value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                        "url": { "type": "string" }
                      }
                    }
                  ]
                },
                "stars": {
                  "oneOf": [
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "label": { "type": "string" },
                        "badge_label": { "type": "string" },
                        "icon": { "type": "string" },
                        "accent": { "type": "string" },
                        "prefix": { "type": "string" },
                        "suffix": { "type": "string" },
                        "sub": { "type": "string" },
                        "value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                        "display_value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                        "url": { "type": "string" }
                      }
                    }
                  ]
                },
                "followers": {
                  "oneOf": [
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "label": { "type": "string" },
                        "badge_label": { "type": "string" },
                        "icon": { "type": "string" },
                        "accent": { "type": "string" },
                        "prefix": { "type": "string" },
                        "suffix": { "type": "string" },
                        "sub": { "type": "string" },
                        "value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                        "display_value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                        "url": { "type": "string" }
                      }
                    }
                  ]
                },
                "views": {
                  "oneOf": [
                    { "type": "boolean" },
                    {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "label": { "type": "string" },
                        "badge_label": { "type": "string" },
                        "icon": { "type": "string" },
                        "accent": { "type": "string" },
                        "prefix": { "type": "string" },
                        "suffix": { "type": "string" },
                        "sub": { "type": "string" },
                        "value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                        "display_value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                        "url": { "type": "string" }
                      }
                    }
                  ]
                }
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean" },
                  "label": { "type": "string" },
                  "badge_label": { "type": "string" },
                  "icon": { "type": "string" },
                  "accent": { "type": "string" },
                  "prefix": { "type": "string" },
                  "suffix": { "type": "string" },
                  "sub": { "type": "string" },
                  "value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                  "display_value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                  "url": { "type": "string" }
                }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string" },
                  "enabled": { "type": "boolean" },
                  "label": { "type": "string" },
                  "badge_label": { "type": "string" },
                  "icon": { "type": "string" },
                  "accent": { "type": "string" },
                  "prefix": { "type": "string" },
                  "suffix": { "type": "string" },
                  "sub": { "type": "string" },
                  "value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                  "display_value": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
                  "url": { "type": "string" }
                }
              }
            }
          ]
        },
        "statusline": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "tenure_label": { "type": "string" },
            "tenure": { "type": "string" },
            "fleet_label": { "type": "string" },
            "fleet": { "type": "string" },
            "pipeline_label": { "type": "string" },
            "pipeline": { "type": "string" },
            "sync_text": { "type": "string" }
          }
        }
      }
    },

    "socials": {
      "description": "Communication endpoints, social networks, and handles.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "banner": { "type": "boolean", "default": false, "description": "Whether to compile the 880px terminal banner card." },
            "badges": { "type": "boolean", "default": true, "description": "Whether to compile the split-pill badge buttons." },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label", "handle", "url"],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": ["telegram", "discord", "email", "github", "linkedin", "x", "web"]
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Whether to render this channel in the socials terminal card."
                  },
                  "label": { "type": "string" },
                  "handle": { "type": "string" },
                  "display_handle": { "type": "string" },
                  "url": { "type": "string" },
                  "accent": {
                    "type": "string",
                    "enum": ["primary", "secondary", "success", "warning", "danger"]
                  },
                  "tag": { "type": "string" },
                  "description": { "type": "string" },
                  "latency": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "handle", "url"],
            "properties": {
              "id": {
                "type": "string",
                "enum": ["telegram", "discord", "email", "github", "linkedin", "x", "web"]
              },
              "enabled": {
                "type": "boolean",
                "description": "Whether to render this channel in the socials terminal card."
              },
              "label": { "type": "string" },
              "handle": { "type": "string" },
              "display_handle": { "type": "string" },
              "url": { "type": "string" },
              "accent": {
                "type": "string",
                "enum": ["primary", "secondary", "success", "warning", "danger"]
              },
              "tag": { "type": "string" },
              "description": { "type": "string" },
              "latency": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
